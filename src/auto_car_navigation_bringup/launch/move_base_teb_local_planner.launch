<launch>
  <!-- Arguments -->
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="odom_topic" default="odom" />
  <!-- <arg name="move_forward_only" default="false"/> -->

  <!-- move_base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/move_base_params.yaml" command="load" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/global_planner_params.yaml" command="load" />
    <rosparam file="$(find auto_car_navigation_bringup)/param/teb_local_planner.yaml" command="load" />    
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
		<param name="base_global_planner" value="global_planner/GlobalPlanner" />
		<param name="planner_frequency" value="1.0" />
		<param name="planner_patience" value="5.0" />
		<param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
		<param name="controller_frequency" value="5.0" />
		<param name="controller_patience" value="15.0" />
    <param name="clearing_rotation_allowed" value="false" />

  </node>
</launch>
